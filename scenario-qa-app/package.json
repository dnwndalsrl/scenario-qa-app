{
  "name": "url-ai-qa-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3100",
    "fixture": "node test/fixtures/site/server.mjs",
    "local:start": "node scripts/start-local.mjs",
    "qa:run": "tsx scripts/run-analysis.ts",
    "qa:run-test": "tsx scripts/run-single-test.ts",
    "qa:run-approved": "tsx scripts/run-approved-tests.ts",
    "qa:validate-input": "tsx scripts/validate-analysis-input.ts",
    "qa:mark-failed": "tsx scripts/mark-analysis-failed.ts",
    "qa:mark-test-failed": "tsx scripts/mark-test-run-failed.ts",
    "qa:mark-approved-failed": "tsx scripts/mark-approved-tests-failed.ts",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "nuxt": "^4.0.3",
    "openai": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "vue": "^3.5.18",
    "vue-bundle-renderer": "^2.3.1",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "sass": "^1.89.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.4"
  }
}
