{
  "name": "scenario-qa-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:target": "node sample-target/server.mjs",
    "playwright:install": "npm --prefix ../scenario-test-runner exec -- playwright install chromium",
    "storage:sanitize": "node --env-file=.env scripts/sanitize-storage.mjs",
    "storage:sanitize-screenshots": "node --env-file=.env scripts/remove-sensitive-screenshot-artifacts.mjs",
    "storage:inspect": "node --env-file=.env scripts/inspect-storage.mjs",
    "storage:cleanup-temporary": "node --env-file=.env scripts/cleanup-stale-storage-temporary.mjs",
    "seed:test-suite": "node scripts/seed-admin-test-suite.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "preflight:northflank": "npm ci && npm run preflight:northflank:verify",
    "preflight:northflank:verify": "tsx scripts/northflank-preflight.ts",
    "smoke:northflank": "tsx scripts/northflank-smoke-test.ts",
    "auth:generate": "tsx scripts/northflank-auth-hash.ts"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "cron-parser": "^5.7.0",
    "element-plus": "^2.11.1",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.0.3",
    "openai": "^7.2.0",
    "pinia": "^3.0.3",
    "playwright": "1.62.1",
    "scenario-test-runner": "file:../scenario-test-runner",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^8.0.1",
    "sass": "^1.89.2",
    "tsx": "4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.4"
  }
}
