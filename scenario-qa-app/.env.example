# Nuxt/Vercel (server-only unless NUXT_PUBLIC_ prefix is present)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-vercel-only
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NUXT_PUBLIC_SIGNUP_ENABLED=false
NUXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Vercel -> GitHub Actions dispatch (fine-grained token: Actions write)
GITHUB_ACTIONS_TOKEN=replace-on-vercel-only
GITHUB_OWNER=your-github-owner
GITHUB_REPOSITORY=your-repository
GITHUB_WORKFLOW_FILE=run-qa-analysis.yml
GITHUB_DEPLOY_BRANCH=main
DISPATCH_RECOVERY_SECRET=
ANALYSIS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-string-of-at-least-32-characters

# GitHub Actions runner secrets only
OPENAI_API_KEY=
OPENAI_PAGE_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TEST_GENERATION_MODEL=gpt-5-mini

# Local runner/fixture overrides; never enable local targets in production
ALLOW_LOCAL_TEST_TARGETS=false
ALLOWED_LOCAL_TEST_PORTS=3000,3001
NUXT_STORAGE_ROOT=./storage
ANALYSIS_SCREENSHOT_ENABLED=true
ANALYSIS_ARTIFACT_MAX_SIZE_MB=10
MAX_CRAWL_PAGES=5
DEFAULT_CRAWL_PAGES=3
MAX_CRAWL_DEPTH=2
DEFAULT_CRAWL_DEPTH=1
MAX_TOTAL_GENERATED_TESTS=8
MAX_TOTAL_AUTO_RUN_TESTS=8
MAX_ANALYSIS_EXECUTION_MS=540000
PAGE_LOAD_TIMEOUT_MS=20000
CRAWL_TOTAL_TIMEOUT_MS=180000
