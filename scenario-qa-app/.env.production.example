# Copy to .env.production and replace every <...> placeholder before deployment.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DOMAIN=<DOMAIN>
LETSENCRYPT_EMAIL=<LETSENCRYPT_EMAIL>
APP_BASE_URL=https://<DOMAIN>
NUXT_PUBLIC_APP_BASE_URL=https://<DOMAIN>
NOTIFICATION_APP_BASE_URL=https://<DOMAIN>
NUXT_STORAGE_ROOT=/app/storage
ALLOW_LOCAL_TEST_TARGETS=false
ALLOWED_LOCAL_TEST_PORTS=

APP_IMAGE=scenario-qa-app
APP_VERSION=latest
GIT_COMMIT_SHA=unknown
BUILD_TIMESTAMP=unknown

# External test target. Leave credentials blank until configured on the server.
TEST_TARGET_BASE_URL=
TEST_TARGET_ENVIRONMENT=staging
TEST_LOGIN_ID=
TEST_LOGIN_PASSWORD=
TEST_INVALID_LOGIN_ID=
TEST_INVALID_LOGIN_PASSWORD=
TEST_ADMIN_ID=
TEST_ADMIN_PASSWORD=
HEADLESS=true

# Capacity and retention.
MAX_PROJECTS=20
MAX_SCENARIOS_PER_PROJECT=100
MAX_STEPS_PER_SCENARIO=50
MAX_SUITES_PER_PROJECT=30
MAX_SUITE_ITEMS=50
MAX_SCHEDULES_PER_PROJECT=100
MAX_CONCURRENT_TEST_RUNS=1
MAX_TEST_EXECUTION_MS=300000
MAX_SCREENSHOT_SIZE_MB=10
MAX_LOG_ITEMS_PER_RUN=500
STORAGE_BACKUP_COUNT=5
STORAGE_TEMP_RETENTION_MINUTES=15
TEST_RESULT_RETENTION_DAYS=90
TEST_ARTIFACT_RETENTION_DAYS=30
TEST_MAX_ARTIFACT_STORAGE_MB=1024
TEST_STORAGE_CLEANUP_ENABLED=true
MAX_REQUEST_BODY_BYTES=5242880

# Scheduler.
TEST_SCHEDULER_ENABLED=true
TEST_SCHEDULER_TICK_INTERVAL_MS=30000
TEST_SCHEDULE_DEFAULT_TIMEZONE=Asia/Seoul
TEST_SCHEDULE_MAX_PER_SUITE=10
TEST_SCHEDULE_MAX_PER_PROJECT=100
TEST_SCHEDULE_MIN_INTERVAL_MINUTES=15
TEST_SCHEDULE_EXECUTION_VERSION=v1

# Suite execution and regression comparison.
TEST_SUITE_MAX_ITEMS=50
TEST_SUITE_POLL_INTERVAL_MS=2000
TEST_SUITE_MAX_EXECUTION_MS=1800000
TEST_SUITE_ALLOW_CONCURRENT_RUNS=false
TEST_SUITE_RUN_VERSION=v1
TEST_RUN_COMPARISON_VERSION=v1
REGRESSION_DURATION_WARNING_RATE=0.3
REGRESSION_DURATION_CRITICAL_RATE=0.8
REGRESSION_DURATION_MIN_DIFFERENCE_MS=500
REGRESSION_DURATION_CRITICAL_DIFFERENCE_MS=1000
REGRESSION_STEP_MATCH_MIN_CONFIDENCE=0.8
REGRESSION_MAX_CONSOLE_ITEMS=100
REGRESSION_MAX_NETWORK_ITEMS=100

# Optional OpenAI features. Models may remain blank to keep the feature disabled.
OPENAI_API_KEY=
OPENAI_SCENARIO_MODEL=
OPENAI_SCENARIO_PROMPT_VERSION=v1
AI_SCENARIO_MAX_INPUT_LENGTH=10000
AI_SCENARIO_MAX_STEPS=50
AI_SCENARIO_TIMEOUT_MS=60000
OPENAI_FAILURE_ANALYSIS_MODEL=
OPENAI_FAILURE_ANALYSIS_PROMPT_VERSION=v1
AI_FAILURE_ANALYSIS_TIMEOUT_MS=60000
AI_FAILURE_ANALYSIS_MAX_CAUSES=5
AI_FAILURE_ANALYSIS_MAX_ACTIONS=8
AI_FAILURE_ANALYSIS_MAX_CHECKS=8
AI_ANALYSIS_MAX_FAILED_STEPS=20
AI_ANALYSIS_MAX_CONSOLE_ERRORS=30
AI_ANALYSIS_MAX_NETWORK_ERRORS=30
AI_ANALYSIS_MAX_MESSAGE_LENGTH=2000
AI_ANALYSIS_MAX_TOTAL_INPUT_LENGTH=30000
OPENAI_QUALITY_SUMMARY_MODEL=
OPENAI_QUALITY_SUMMARY_PROMPT_VERSION=v1
QUALITY_SCORE_ENABLED=false

# Optional notifications. Keep provider disabled until all corresponding values exist.
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_MAX_RETRY_COUNT=3
NOTIFICATION_RETRY_DELAY_MS=5000

# Analytics.
ANALYTICS_VERSION=v1
DEFAULT_RANGE_DAYS=30
MAX_RANGE_DAYS=730
CACHE_TTL_MS=60000
MAX_TIMESERIES_POINTS=400
TOP_SCENARIOS_LIMIT=20
TOP_STEPS_LIMIT=20
TOP_ERRORS_LIMIT=20
RECENT_ISSUES_LIMIT=20
MIN_SAMPLE_FOR_TREND=5
QUALITY_SUCCESS_WARNING=0.95
QUALITY_SUCCESS_DANGER=0.80
QUALITY_REGRESSION_WARNING=0.05
QUALITY_REGRESSION_DANGER=0.15
QUALITY_ERROR_WARNING=0.02
QUALITY_ERROR_DANGER=0.10

BACKUP_RETENTION_COUNT=10
BACKUP_RETENTION_DAYS=30
