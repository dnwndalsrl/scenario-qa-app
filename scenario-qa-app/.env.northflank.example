# Register values in Northflank runtime variables/secrets. Do not upload this file with real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
NUXT_STORAGE_ROOT=/app/storage

APP_BASE_URL=https://<northflank-generated-domain>
NUXT_PUBLIC_APP_BASE_URL=https://<northflank-generated-domain>
NOTIFICATION_APP_BASE_URL=https://<northflank-generated-domain>
APP_DEPLOYMENT_MODE=free_sandbox
APP_DEMO_MODE=true
PERSISTENT_STORAGE_AVAILABLE=false

# Generate locally with: npm run auth:generate
APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD_HASH=
APP_SESSION_SECRET=

# Free Sandbox resource guardrails.
MAX_CONCURRENT_TEST_RUNS=1
MAX_SUITE_CONCURRENT_RUNS=1
TEST_SUITE_ALLOW_CONCURRENT_RUNS=false
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_PAGES=1
PLAYWRIGHT_DISABLE_DEV_SHM_USAGE=false
MAX_TEST_EXECUTION_MS=180000
MAX_LOG_ITEMS_PER_RUN=200
MAX_SCREENSHOTS_PER_RUN=5
MAX_SCREENSHOT_SIZE_MB=4
MAX_STEPS_PER_SCENARIO=20
MAX_PROJECTS=10
MAX_SCENARIOS_PER_PROJECT=30
MAX_SUITES_PER_PROJECT=10
TEST_SUITE_MAX_ITEMS=10
TEST_SUITE_MAX_EXECUTION_MS=180000
TEST_SUITE_POLL_INTERVAL_MS=2000
MAX_REQUEST_BODY_BYTES=1048576
STORAGE_BACKUP_COUNT=2
STORAGE_TEMP_RETENTION_MINUTES=15
TEST_ARTIFACT_RETENTION_DAYS=7
TEST_RESULT_RETENTION_DAYS=14
TEST_MAX_ARTIFACT_STORAGE_MB=200
# This flag is reserved for a reviewed retention worker. The initial ephemeral
# deployment keeps it off; do not claim automatic deletion is active.
TEST_STORAGE_CLEANUP_ENABLED=false

# Enable only after a persistent volume has been attached and verified.
TEST_SCHEDULER_ENABLED=false
TEST_SCHEDULER_TICK_INTERVAL_MS=30000
TEST_SCHEDULE_DEFAULT_TIMEZONE=Asia/Seoul
TEST_SCHEDULE_MAX_PER_SUITE=1
TEST_SCHEDULE_MAX_PER_PROJECT=1
TEST_SCHEDULE_MIN_INTERVAL_MINUTES=60

ALLOW_LOCAL_TEST_TARGETS=false
ALLOWED_LOCAL_TEST_PORTS=
TEST_TARGET_BASE_URL=
TEST_TARGET_ENVIRONMENT=staging
TEST_LOGIN_ID=
TEST_LOGIN_PASSWORD=
TEST_INVALID_LOGIN_ID=
TEST_INVALID_LOGIN_PASSWORD=

# Optional AI. Keep model names blank when no API key is configured.
OPENAI_API_KEY=
OPENAI_SCENARIO_MODEL=
OPENAI_FAILURE_ANALYSIS_MODEL=
OPENAI_QUALITY_SUMMARY_MODEL=
QUALITY_SCORE_ENABLED=false

# Optional notifications. In-app notifications work without external credentials.
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_MAX_RETRY_COUNT=2
NOTIFICATION_RETRY_DELAY_MS=5000

APP_VERSION=northflank-sandbox
GIT_COMMIT_SHA=
BUILD_TIMESTAMP=
