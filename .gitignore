# Dependencies and build output
**/node_modules/
**/.nuxt/
**/.output/
**/.vercel/
**/coverage/
**/playwright-report/
**/test-results/

# Runtime data must never be committed
**/storage/
**/artifacts/
!**/server/api/**/artifacts/
!**/server/api/**/artifacts/**
**/data/
**/logs/
**/backups/
**/.deploy-state/
**/.supabase/
**/*.log

# Secrets and local configuration
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
!**/.env.northflank.example
**/*.pem
**/*.key
**/.htpasswd

# Local tooling and generated readiness evidence
**/.DS_Store
**/.idea/
**/.vscode/
scenario-qa-app/readiness-*.json
scenario-qa-app/readiness-*.log
scenario-qa-app/.app-*.log
scenario-qa-app/.target-*.log

# Historical starter copy is not part of the deployable monorepo
starter-code/
.northflank-cli/
.vercel/
.env.local

# Local Codex, deployment, and test scratch data
.deployment/
.sync/
.tools/
scenario-qa-app/.codex-tmp/
scenario-qa-app/.deploy-cache/
scenario-qa-app/.npm-cache/
scenario-qa-app/.test-tmp/
scenario-qa-app/.tmp-test/
scenario-qa-app/.tmp/
scenario-qa-app/.vercel-global/
scenario-qa-app/.vercel-xdg/
